# URL publique de l'API back (vue par le navigateur).
VITE_API_URL=http://localhost:8000
# URL publique de fastauth (vue par le navigateur).
VITE_FASTAUTH_URL=http://localhost:8001
# Cible du proxy dev Vite (/api, /ws). En docker: http://back:8000
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Sentry (erreurs front). Vide = désactivé.
VITE_SENTRY_DSN=
# PostHog (analytics produit). Clé vide = désactivé.
VITE_POSTHOG_KEY=
# Hôte PostHog, défaut https://eu.i.posthog.com si vide.
VITE_POSTHOG_HOST=
